# Không bắt buộc. ID extension "Địa Bạ Profiler" đã cố định bằng "key" trong manifest.json (repo biz-profile-audit-ext)
# (coonkgehlckihibjghcejllijbhjjknd); chỉ đặt biến này khi chuyển sang bản Chrome Web Store có ID khác.
NEXT_PUBLIC_DIABA_EXTENSION_ID=

# Bắt buộc cho AI fallback của extension: ký token ngắn hạn để trình duyệt gọi thẳng AI Gateway (không đi qua hàm Netlify).
# Đặt cùng giá trị với GATEWAY_TOKEN_SECRET trên AI Gateway (Koyeb).
GATEWAY_TOKEN_SECRET=
